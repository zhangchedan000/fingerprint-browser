@@ -26,7 +28,45 @@ void ApproximatedDeviceMemory::Initialize() {
 }
 
 // static
+namespace {
+
+// Same string as switches::kFingerprintDeviceMemory (components/ungoogled);
+// spelled out so blink/common needs no dependency on that component.
+constexpr char kFingerprintDeviceMemorySwitch[] = "fingerprint-device-memory";
+
+// The configured value when it is one desktop Chrome itself can report
+// (CalculateAndSetApproximatedDeviceMemory below clamps to 2..32 and rounds
+// to a power of two), else 0.
+float ConfiguredDeviceMemoryGb() {
+  if (!base::CommandLine::InitializedForCurrentProcess()) {
+    return 0.0f;
+  }
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(kFingerprintDeviceMemorySwitch)) {
+    return 0.0f;
+  }
+  int value = 0;
+  if (!base::StringToInt(
+          command_line->GetSwitchValueASCII(kFingerprintDeviceMemorySwitch),
+          &value)) {
+    return 0.0f;
+  }
+  for (int allowed : {2, 4, 8, 16, 32}) {
+    if (value == allowed) {
+      return static_cast<float>(value);
+    }
+  }
+  return 0.0f;
+}
+
+}  // namespace
+
 float ApproximatedDeviceMemory::GetApproximatedDeviceMemory() {
+  const float configured = ConfiguredDeviceMemoryGb();
+  if (configured > 0.0f) {
+    return configured;
+  }
   return approximated_device_memory_gb_;
 }
 
