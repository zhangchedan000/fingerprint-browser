+// fingerprint: a per-profile, repeatable change to the rendered samples.
+// Applied to the buffer itself before it reaches the page, so
+// getChannelData() and copyFromChannel() always agree. Roughly one sample in
+// a hundred moves by 1e-7..3e-7 (a few float32 steps at typical levels);
+// silent samples and the first 100 frames stay exact.
+uint32_t NextAudioNoiseState(uint32_t state) {
+  state ^= state << 13;
+  state ^= state >> 17;
+  state ^= state << 5;
+  return state;
+}
+
+void ApplyFingerprintAudioNoise(AudioBuffer* buffer) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+              .find("audio") != std::string::npos) {
+    return;
+  }
+  uint32_t fingerprint = 0;
+  if (!base::StringToUint(
+          command_line->GetSwitchValueASCII(switches::kFingerprint),
+          &fingerprint)) {
+    return;
+  }
+  for (unsigned channel = 0; channel < buffer->numberOfChannels();
+       ++channel) {
+    NotShared<DOMFloat32Array> channel_data = buffer->getChannelData(channel);
+    if (!channel_data) {
+      continue;
+    }
+    base::span<float> samples = channel_data->AsSpan();
+    if (samples.size() <= 100u) {
+      continue;
+    }
+    uint32_t state = fingerprint ^ (0x9e3779b9u * (channel + 1)) ^
+                     static_cast<uint32_t>(samples.size());
+    state = NextAudioNoiseState(state | 1u);
+    const size_t stride = 89u + (state % 29u);
+    for (size_t index = 100u + (state % 53u); index < samples.size();
+         index += stride) {
+      state = NextAudioNoiseState(state);
+      const float sample = samples[index];
+      if (!std::isfinite(sample) || std::abs(sample) < 1.0e-8f) {
+        continue;
+      }
+      const float magnitude =
+          static_cast<float>(1u + ((state >> 1) % 3u)) * 1.0e-7f;
+      samples[index] =
+          std::clamp(sample + ((state & 1u) ? magnitude : -magnitude), -1.0f,
+                     1.0f);
+    }
+  }
+}
+
 }  // namespace
 
