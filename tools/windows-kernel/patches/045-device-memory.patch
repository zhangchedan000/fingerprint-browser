diff --git a/third_party/blink/common/device_memory/approximated_device_memory.cc b/third_party/blink/common/device_memory/approximated_device_memory.cc
index fee5a18..484e9a8 100644
--- a/third_party/blink/common/device_memory/approximated_device_memory.cc
+++ b/third_party/blink/common/device_memory/approximated_device_memory.cc
@@ -5,10 +5,41 @@
 #include "third_party/blink/public/common/device_memory/approximated_device_memory.h"
 
 #include "base/check_op.h"
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/system/sys_info.h"
 
 namespace blink {
 
+namespace {
+
+// Same string as switches::kFingerprintDeviceMemory; spelled out so blink/common
+// does not need a dependency on components/ungoogled.
+constexpr char kFingerprintDeviceMemorySwitch[] = "fingerprint-device-memory";
+
+// Returns the configured value when it is one Chrome itself can report, else 0.
+float ConfiguredDeviceMemoryGb() {
+  const base::CommandLine* command_line =
+      base::CommandLine::InitializedForCurrentProcess()
+          ? base::CommandLine::ForCurrentProcess()
+          : nullptr;
+  if (!command_line || !command_line->HasSwitch(kFingerprintDeviceMemorySwitch))
+    return 0.0;
+  double value = 0.0;
+  if (!base::StringToDouble(
+          command_line->GetSwitchValueASCII(kFingerprintDeviceMemorySwitch),
+          &value)) {
+    return 0.0;
+  }
+  for (double allowed : {0.25, 0.5, 1.0, 2.0, 4.0, 8.0}) {
+    if (value == allowed)
+      return static_cast<float>(value);
+  }
+  return 0.0;
+}
+
+}  // namespace
+
 // static
 float ApproximatedDeviceMemory::approximated_device_memory_gb_ = 0.0;
 int64_t ApproximatedDeviceMemory::physical_memory_mb_ = 0;
@@ -57,6 +88,12 @@ void ApproximatedDeviceMemory::CalculateAndSetApproximatedDeviceMemory() {
   // high-spec machines.
   if (approximated_device_memory_gb_ > 8)
     approximated_device_memory_gb_ = 8.0;
+
+  // A fingerprint profile's value wins, so navigator.deviceMemory and the
+  // Device-Memory client hint always agree.
+  const float configured = ConfiguredDeviceMemoryGb();
+  if (configured > 0.0)
+    approximated_device_memory_gb_ = configured;
 }
 
 // static
