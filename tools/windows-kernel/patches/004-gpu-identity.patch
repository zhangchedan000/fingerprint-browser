 #include "third_party/blink/renderer/bindings/core/v8/v8_object_builder.h"
@@ -31,6 +34,70 @@ namespace blink {
 
 namespace {
 
+
+// fingerprint: GPUAdapterInfo for the GPU named by --fingerprint-gpu-*.
+// Chrome reports vendor and architecture (device and description stay empty
+// unless WebGPU developer features are on). Dawn derives the architecture
+// from the PCI device id; this is Dawn's own table (src/dawn/gpu_info.json,
+// NVIDIA desktop/laptop devices, mask 0xFFFFFF00), lower-cased as Chrome
+// reports it. Only applied when the configured vendor is the real one, so
+// limits and features keep matching the reported vendor.
+const char* FingerprintNvidiaArchitecture(uint32_t device_id) {
+  switch (device_id & 0xFF00) {
+    case 0x1E00:
+    case 0x1F00:
+    case 0x2100:
+      return "turing";
+    case 0x2000:
+    case 0x2200:
+    case 0x2400:
+    case 0x2500:
+      return "ampere";
+    case 0x2600:
+    case 0x2700:
+    case 0x2800:
+      return "lovelace";
+    case 0x2B00:
+    case 0x2C00:
+    case 0x2D00:
+    case 0x2F00:
+      return "blackwell";
+    default:
+      return nullptr;
+  }
+}
+
+void ApplyFingerprintGpuIdentity(uint32_t native_vendor_id,
+                                 String* architecture,
+                                 String* device) {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+              .find("gpu") != std::string::npos) {
+    return;
+  }
+  uint32_t vendor_id = 0;
+  uint32_t device_id = 0;
+  if (!base::HexStringToUInt(
+          command_line->GetSwitchValueASCII(switches::kFingerprintGpuVendorId),
+          &vendor_id) ||
+      !base::HexStringToUInt(
+          command_line->GetSwitchValueASCII(switches::kFingerprintGpuDeviceId),
+          &device_id) ||
+      device_id == 0 || device_id > 0xffff || vendor_id != native_vendor_id) {
+    return;
+  }
+  if (vendor_id == 0x10DE) {
+    const char* nvidia_architecture = FingerprintNvidiaArchitecture(device_id);
+    if (!nvidia_architecture) {
+      return;
+    }
+    *architecture = String(nvidia_architecture);
+  }
+  *device = Format("0x{:04x}", device_id);
+}
+
 GPUSupportedFeatures* MakeFeatureNameSet(wgpu::Adapter adapter) {
   GPUSupportedFeatures* features = MakeGarbageCollected<GPUSupportedFeatures>();
   DCHECK(features->FeatureNameSet().empty());
