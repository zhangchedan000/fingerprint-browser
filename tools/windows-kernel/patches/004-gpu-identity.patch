diff --git third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
new file mode 100644
index 0000000..1bc3089
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
@@ -0,0 +1,117 @@
+#include "third_party/blink/renderer/modules/webgl/gpu_fingerprint.h"
+
+#include <optional>
+
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/strcat.h"
+#include "base/strings/string_util.h"
+#include "base/strings/stringprintf.h"
+#include "components/ungoogled/ungoogled_switches.h"
+
+// How the real string is made (ANGLE, src/libANGLE/Context.cpp
+// initRendererString and d3d11/Renderer11.cpp getRendererDescription):
+//   "ANGLE (" vendor ", " adapter-description " (0x%08X)" " Direct3D11"
+//   ["on12"] " vs_5_0 ps_5_0" ", " "D3D11" ")"
+// WebGL contexts never get the driver version after "D3D11", and commas are
+// removed from each part. Only the adapter description and the device id
+// differ between GPUs of one vendor, so only those two parts are replaced.
+
+namespace blink {
+
+namespace {
+
+struct ConfiguredGpu {
+  uint32_t vendor_id = 0;
+  uint32_t device_id = 0;
+  std::string description;
+};
+
+std::optional<ConfiguredGpu> GetConfiguredGpu() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(switches::kDisableSpoofing) &&
+      command_line->GetSwitchValueASCII(switches::kDisableSpoofing)
+              .find("gpu") != std::string::npos) {
+    return std::nullopt;
+  }
+  if (!command_line->HasSwitch(switches::kFingerprintGpuVendorId) ||
+      !command_line->HasSwitch(switches::kFingerprintGpuDeviceId) ||
+      !command_line->HasSwitch(switches::kFingerprintGpuDescription)) {
+    return std::nullopt;
+  }
+  ConfiguredGpu gpu;
+  if (!base::HexStringToUInt(
+          command_line->GetSwitchValueASCII(switches::kFingerprintGpuVendorId),
+          &gpu.vendor_id) ||
+      !base::HexStringToUInt(
+          command_line->GetSwitchValueASCII(switches::kFingerprintGpuDeviceId),
+          &gpu.device_id) ||
+      gpu.device_id == 0 || gpu.device_id > 0xffff) {
+    return std::nullopt;
+  }
+  const std::string description =
+      command_line->GetSwitchValueASCII(switches::kFingerprintGpuDescription);
+  if (description.empty() || description.size() > 128) {
+    return std::nullopt;
+  }
+  for (char character : description) {
+    if (character < 0x20 || character > 0x7e) {
+      return std::nullopt;
+    }
+    if (character != ',') {
+      gpu.description.push_back(character);
+    }
+  }
+  return gpu;
+}
+
+// ANGLE's GetVendorString (src/libANGLE/renderer/driver_utils.cpp).
+const char* AngleVendorName(uint32_t vendor_id) {
+  switch (vendor_id) {
+    case 0x10DE:
+      return "NVIDIA";
+    case 0x1002:
+      return "AMD";
+    case 0x8086:
+      return "Intel";
+    default:
+      return nullptr;
+  }
+}
+
+}  // namespace
+
+std::string GetGLVendorStringForFingerprint() {
+  return std::string();
+}
+
+std::string GetGLRendererStringForFingerprint(
+    const std::string& native_renderer) {
+  const std::optional<ConfiguredGpu> gpu = GetConfiguredGpu();
+  if (!gpu) {
+    return std::string();
+  }
+  const char* vendor = AngleVendorName(gpu->vendor_id);
+  if (!vendor) {
+    return std::string();
+  }
+  const std::string prefix = base::StrCat({"ANGLE (", vendor, ", "});
+  if (!base::StartsWith(native_renderer, prefix)) {
+    return std::string();
+  }
+  const size_t id_start = native_renderer.find(" (0x", prefix.size());
+  if (id_start == std::string::npos) {
+    return std::string();
+  }
+  const size_t id_end = native_renderer.find(')', id_start);
+  if (id_end == std::string::npos) {
+    return std::string();
+  }
+  return base::StrCat(
+      {prefix, gpu->description,
+       base::StringPrintf(" (0x%08X)", gpu->device_id),
+       native_renderer.substr(id_end + 1)});
+}
+
+}  // namespace blink
