+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+
+#include <string>
+
+namespace blink {
+
+// UNMASKED_VENDOR_WEBGL is never rewritten: the profile's GPU must come from
+// the same vendor as the real adapter, so the native "Google Inc. (NVIDIA)"
+// is already the right value. Kept for the call site; always returns "".
+std::string GetGLVendorStringForFingerprint();
+
+// UNMASKED_RENDERER_WEBGL for the GPU named by --fingerprint-gpu-*, built from
+// the real ANGLE string so the backend part stays exactly what this machine
+// reports. Returns "" (keep the native string) when no GPU is configured, GPU
+// spoofing is disabled, or the configured vendor differs from the real one.
+std::string GetGLRendererStringForFingerprint(
+    const std::string& native_renderer);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
