 // Enable fingerprinting deception for Canvas image data
 const char kFingerprintingCanvasImageDataNoise[] = "fingerprinting-canvas-image-data-noise";
 
+// Specify the fingerprint seed
+const char kFingerprint[] = "fingerprint";
+
+// Specify the browser brand
+const char kFingerprintBrand[] = "fingerprint-brand";
+
+// Specify the browser version
+const char kFingerprintBrandVersion[] = "fingerprint-brand-version";
+
+// Disable fingerprint spoofing
+const char kDisableSpoofing[] = "disable-spoofing";
+
+// Specify the screen width
+const char kFingerprintScreenWidth[] = "fingerprint-screen-width";
+
+// Specify the screen height
+const char kFingerprintScreenHeight[] = "fingerprint-screen-height";
+
+// Specify the device scale factor
+const char kFingerprintDeviceScaleFactor[] = "fingerprint-device-scale-factor";
+
+// Specify the number of CPU cores
+const char kFingerprintHardwareConcurrency[] = "fingerprint-hardware-concurrency";
+
+// Specify the operating system type
+const char kFingerprintPlatform[] = "fingerprint-platform";
+
+// Specify the operating system version
+const char kFingerprintPlatformVersion[] = "fingerprint-platform-version";
+
+// Specify the location
+const char kFingerprintLocation[] = "fingerprint-location";
+
+// Specify the timezone
+const char kFingerprintTimezone[] = "timezone";
+
+// PCI vendor id of the GPU the profile describes, e.g. 0x10DE
+const char kFingerprintGpuVendorId[] = "fingerprint-gpu-vendor-id";
+
+// PCI device id of that GPU, e.g. 0x2208
+const char kFingerprintGpuDeviceId[] = "fingerprint-gpu-device-id";
+
+// Adapter name exactly as the Windows driver reports it
+const char kFingerprintGpuDescription[] = "fingerprint-gpu-description";
+
+// navigator.deviceMemory and the Device-Memory hint, in GB
+const char kFingerprintDeviceMemory[] = "fingerprint-device-memory";
+
+// screen.availHeight (screen height minus the taskbar)
+const char kFingerprintScreenAvailHeight[] = "fingerprint-screen-avail-height";
+
 }  // namespace switches
