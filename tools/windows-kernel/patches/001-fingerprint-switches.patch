+COMPONENT_EXPORT(UNGOOGLED) extern const char kFingerprintGpuVendorId[];
+COMPONENT_EXPORT(UNGOOGLED) extern const char kFingerprintGpuDeviceId[];
+COMPONENT_EXPORT(UNGOOGLED) extern const char kFingerprintGpuDescription[];
